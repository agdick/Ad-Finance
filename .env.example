# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------
# Login for the single user.
APP_USERNAME=alex
APP_PASSWORD=
# Signs the login cookie. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts bank access tokens at rest. Generate:
#   docker compose run --rm app python -m app.cli gen-key
# or: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe: without it, stored bank connections must be re-linked.
ENCRYPTION_KEY=

# --- Bank sync (optional; CSV import and manual entry work without it) -----
PLAID_CLIENT_ID=
PLAID_SECRET=
# "production" for real data (the Trial plan uses production), "sandbox" for testing.
PLAID_ENV=production
# Requested only where the institution supports them.
PLAID_OPTIONAL_PRODUCTS=liabilities,investments
PLAID_COUNTRY_CODES=CA
PLAID_DAYS_REQUESTED=730
# Hours between automatic syncs (0 = only the "Sync now" button).
SYNC_INTERVAL_HOURS=6

# --- Other ----------------------------------------------------------------
APP_TIMEZONE=America/Toronto
# Set to true when served over HTTPS (e.g. behind a reverse proxy with TLS).
COOKIE_SECURE=false
# Host port the app is published on.
APP_PORT=8000
